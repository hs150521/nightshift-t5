# Board selection
CONFIG_BOARD_CHOICE_T5AI=y
CONFIG_BOARD_CHOICE_TUYA_T5AI_BOARD=y
CONFIG_TUYA_T5AI_BOARD_EX_MODULE_NONE=y

# LCD: 3.5 inch 480x320 RGB565 (ILI9488 + GT1151 touch)
CONFIG_TUYA_T5AI_BOARD_LCD_35565=y

# LVGL
CONFIG_ENABLE_LIBLVGL=y
CONFIG_ENABLE_LVGL_TP=y

# LVGL fonts (used by ui_manager.c)
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# Peripherals
CONFIG_ENABLE_UART=y
# CONFIG_ENABLE_LED is not set

# TLS
CONFIG_ENABLE_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
